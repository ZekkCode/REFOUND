# 2. Next.js Build & Production Output
.next/
out/
build/
dist/

# 3. Environment Variables (Sangat penting: Jangan commit file credentials lokal)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Tetap commit template .env.example
!.env.example

# 4. Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Testing & Coverage
coverage/
.nyc_output/

# 6. Vercel & Cloud Deployments
.vercel

# 7. TypeScript Cache
*.tsbuildinfo
next-env.d.ts

# 8. Editor & OS Specific Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

