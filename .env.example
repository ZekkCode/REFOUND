# ==============================================================================
# REFOUND - Template Variabel Lingkungan (Environment Variables)
# ==============================================================================
# Salin file ini menjadi `.env.local` saat pengembangan lokal:
#   cp .env.example .env.local
#
# Atau masukkan variabel di bawah ini pada pengaturan Vercel Dashboard:
#   Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Konfigurasi Supabase (PostgreSQL + pgvector + Auth + Storage)
# ------------------------------------------------------------------------------
# URL project Supabase Anda (misal: https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co

# Kunci Anonim Publik Supabase (Aman digunakan di browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Kunci Service Role Supabase (Rahasia! Hanya digunakan di server-side/Route Handler)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Konfigurasi Kredensial OAuth Google (Supabase Auth / Google Cloud Console)
# ------------------------------------------------------------------------------
# Client ID Google OAuth dari Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client Secret Google OAuth dari Google Cloud Console
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URL Callback OAuth Google (Redirect URI)
# Lokal: http://localhost:3000/auth/callback
# Produksi: https://refound-app.vercel.app/auth/callback
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# ------------------------------------------------------------------------------
# 3. Konfigurasi AI Engine (Google AI Studio Free Tier / OpenAI)
# ------------------------------------------------------------------------------
# Pilihan provider AI: 'gemini', 'openai', atau 'mock' (default: gemini)
# - Jika 'gemini' & GEMINI_API_KEY valid: Menjalankan Live Gemini 2.5 Flash & text-embedding-004
# - Jika 'mock' atau API Key kosong: Otomatis beralih ke Fail-Safe Local Deterministic Engine (100% Aman Demo)
AI_PROVIDER=gemini

# Google AI Studio API Key (GRATIS tanpa kartu kredit di: https://aistudio.google.com/app/apikey)
# Digunakan untuk:
# 1. text-embedding-004 (768 dimensi vector embedding)
# 2. gemini-2.5-flash / gemini-1.5-flash (LLM Semantic Verification & Question Suggester)
GEMINI_API_KEY=your-gemini-api-key-here

# API Key OpenAI (Opsional, jika ingin menggunakan model OpenAI text-embedding-3-small)
OPENAI_API_KEY=your-openai-api-key-here

# ------------------------------------------------------------------------------
# 4. Konfigurasi Aplikasi & Auto-Deploy Vercel
# ------------------------------------------------------------------------------
# URL domain aplikasi (Lokal: http://localhost:3000 | Produksi: https://refound-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
