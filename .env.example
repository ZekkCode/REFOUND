# ==============================================================================
# REFOUND - Template Variabel Lingkungan (Environment Variables)
# ==============================================================================
# Salin file ini menjadi `.env.local` saat pengembangan lokal,
# atau masukkan variabel di bawah ini pada halaman pengaturannya di Vercel Dashboard:
# Project Settings -> Environment Variables.

# ------------------------------------------------------------------------------
# 1. Konfigurasi Supabase (PostgreSQL + pgvector + Auth + Storage)
# ------------------------------------------------------------------------------
# URL project Supabase Anda (misal: https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co

# Kunci Anonim Publik Supabase (Aman digunakan di browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Kunci Service Role Supabase (Rahasia! Hanya digunakan di server-side/Route Handler)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Konfigurasi Kredensial OAuth Google (Supabase Auth / Google Cloud Console)
# ------------------------------------------------------------------------------
# Client ID Google OAuth dari Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client Secret Google OAuth dari Google Cloud Console
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URL Callback OAuth Google (Redirect URI)
# Lokal: http://localhost:3000/auth/callback
# Produksi: https://refound-app.vercel.app/auth/callback
NEXT_PUBLIC_AUTH_CALLBACK_URL=http://localhost:3000/auth/callback

# ------------------------------------------------------------------------------
# 3. Konfigurasi Provider AI Engine (Embedding & Match Verification)
# ------------------------------------------------------------------------------
# Pilihan provider AI: 'openai', 'gemini', atau 'mock' (default: mock untuk demo)
AI_PROVIDER=mock

# API Key OpenAI (Jika menggunakan text-embedding-3-small atau GPT-4o-mini)
OPENAI_API_KEY=your-openai-api-key-here

# API Key Google Gemini (Jika menggunakan Gemini Embedding / Gemini Pro)
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 4. Konfigurasi Aplikasi & Auto-Deploy Vercel
# ------------------------------------------------------------------------------
# URL domain aplikasi (Lokal: http://localhost:3000 | Vercel: https://refound-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
